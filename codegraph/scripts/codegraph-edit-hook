#!/usr/bin/env python3
"""PostToolUse hook: keep the graph current as the agent edits.

Fires after Write/Edit/NotebookEdit. Rebuilds the affected root incrementally so
the next ``context_for_paths`` reflects code that exists right now rather than
code as it was at session start.

The interesting problem is *rate*. An agent editing a file makes many tool calls
in quick succession, and rebuilding on each one would burn CPU re-parsing a tree
that is about to change again. Two mechanisms handle it:

**Debounce.** A rebuild that ran within ``rebuild_debounce_seconds`` records the
edit as pending and returns. The next hook past the window picks up everything.

**A lock.** A single lock file, containing the holder's pid, keeps concurrent
hook invocations from running overlapping builds. A lock whose owning process is
gone is stolen rather than waited on, so a killed build cannot wedge the graph
permanently.

Like the prompt hook, this always exits 0. A failed rebuild leaves a slightly
stale graph, which is a far better outcome than a failed edit.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

DEBUG = os.environ.get("CODEGRAPH_HOOK_DEBUG") == "1"
LOCK_FILENAME = "rebuild.lock"
PENDING_FILENAME = "pending.json"
LOCK_STALE_SECONDS = 600.0

EDITED_PATH_KEYS = ("file_path", "notebook_path", "path", "filePath")


def log(message: str) -> None:
    if DEBUG:
        print(f"[codegraph-edit-hook] {message}", file=sys.stderr)


def done(system_message: str = "") -> None:
    if system_message:
        print(json.dumps({"systemMessage": system_message}))
    sys.exit(0)


def main() -> None:
    try:
        raw = sys.stdin.read()
        event = json.loads(raw) if raw.strip() else {}
    except (json.JSONDecodeError, OSError) as exc:
        log(f"unreadable hook payload: {exc}")
        done()

    edited = extract_paths(event)
    workspace = resolve_workspace(event)
    if workspace is None:
        log("no codegraph workspace found")
        done()

    try:
        from codegraph.build import build
        from codegraph.config import Config
    except ImportError as exc:
        log(f"codegraph not importable: {exc}")
        done()

    config = Config.load_or_default(workspace)
    state_dir = workspace / ".codegraph"
    state_dir.mkdir(parents=True, exist_ok=True)

    # Which roots did this edit actually touch?  Rebuilding an untouched root
    # is pure waste in a multi-root workspace.
    touched = set()
    for path in edited:
        root = config.root_for_file(workspace, Path(path))
        if root is not None:
            touched.add(root.name)
    if edited and not touched:
        log(f"edit outside every indexed root: {edited}")
        done()

    pending = record_pending(state_dir, touched)
    if within_debounce(workspace, config.rebuild_debounce_seconds):
        log(f"debounced; {len(pending)} root(s) pending")
        done()

    lock = state_dir / LOCK_FILENAME
    if not acquire(lock):
        log("another rebuild holds the lock; left pending")
        done()

    try:
        roots = sorted(pending) or None
        clear_pending(state_dir)
        started = time.perf_counter()
        report = build(
            workspace,
            config,
            roots=roots,
            incremental=True,
            backend_python=os.environ.get("CODEGRAPH_BACKEND_PYTHON"),
        )
        elapsed = time.perf_counter() - started
        log(f"rebuilt {roots or 'all'} in {elapsed:.2f}s -> {report.summary()}")
        if report.errors:
            log(f"errors: {report.errors}")
    except Exception as exc:  # noqa: BLE001 - stale graph beats broken session
        log(f"rebuild failed: {type(exc).__name__}: {exc}")
    finally:
        release(lock)
    done()


def extract_paths(event: dict) -> list[str]:
    tool_input = event.get("tool_input") or {}
    found = []
    for key in EDITED_PATH_KEYS:
        value = tool_input.get(key)
        if isinstance(value, str) and value:
            found.append(value)
    # MultiEdit-style payloads carry a list of per-file edits.
    for entry in tool_input.get("edits", []) or []:
        if isinstance(entry, dict):
            for key in EDITED_PATH_KEYS:
                if isinstance(entry.get(key), str):
                    found.append(entry[key])
    return list(dict.fromkeys(found))


def resolve_workspace(event: dict) -> Path | None:
    argv = sys.argv[1:]
    if "--workspace" in argv:
        candidate = Path(argv[argv.index("--workspace") + 1]).expanduser()
        if (candidate / ".codegraph").is_dir():
            return candidate.resolve()
    for start in (event.get("cwd"), os.environ.get("CLAUDE_PROJECT_DIR"), os.getcwd()):
        if not start:
            continue
        current = Path(start).resolve()
        for candidate in [current, *current.parents]:
            if (candidate / ".codegraph").is_dir():
                return candidate
    return None


def within_debounce(workspace: Path, window: float) -> bool:
    graph = workspace / ".codegraph" / "graph.json"
    if not graph.exists():
        return False
    return (time.time() - graph.stat().st_mtime) < window


def record_pending(state_dir: Path, roots: set[str]) -> set[str]:
    path = state_dir / PENDING_FILENAME
    existing: set[str] = set()
    if path.exists():
        try:
            existing = set(json.loads(path.read_text(encoding="utf-8")).get("roots", []))
        except (json.JSONDecodeError, OSError):
            existing = set()
    merged = existing | roots
    try:
        path.write_text(json.dumps({"roots": sorted(merged), "at": time.time()}), encoding="utf-8")
    except OSError:
        pass
    return merged


def clear_pending(state_dir: Path) -> None:
    try:
        (state_dir / PENDING_FILENAME).unlink(missing_ok=True)
    except OSError:
        pass


def acquire(lock: Path) -> bool:
    """Exclusive-create a lock file, stealing one whose owner is gone."""
    try:
        descriptor = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.write(descriptor, str(os.getpid()).encode())
        os.close(descriptor)
        return True
    except FileExistsError:
        try:
            age = time.time() - lock.stat().st_mtime
            holder = int(lock.read_text().strip() or 0)
        except (OSError, ValueError):
            age, holder = LOCK_STALE_SECONDS + 1, 0
        if age > LOCK_STALE_SECONDS or not _alive(holder):
            log(f"stealing stale lock (pid {holder}, {age:.0f}s old)")
            try:
                lock.unlink(missing_ok=True)
                return acquire(lock)
            except OSError:
                return False
        return False
    except OSError:
        return False


def _alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, owned by someone else


def release(lock: Path) -> None:
    try:
        lock.unlink(missing_ok=True)
    except OSError:
        pass


if __name__ == "__main__":
    main()
